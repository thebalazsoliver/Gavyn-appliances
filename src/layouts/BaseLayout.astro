---
import '../styles/global.css';
const title = 'Gavyn Appliances | Appliance Repair, Installation & Maintenance in GTA & Barrie';
const description =
  'Appliance repairs, installation and maintenance across the Greater Toronto Area and Barrie. G2 certified gas appliance technician. Service calls from $70 + HST.';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#262626" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
  </body>
</html>
